# Local development defaults only. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_MODE=sqlite
SQLITE_DATABASE_NAME=db.sqlite3

# Production PostgreSQL (set these in the backend hosting dashboard)
DATABASE_NAME=finance_trust_sacco
DATABASE_USERNAME=finance_trust_user
DATABASE_PASSWORD=replace-me
DATABASE_HOST=your-postgres-host
DATABASE_PORT=5432

# Comma-separated browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TIME_ZONE=Africa/Kampala

# Optional SMTP credentials; configure only if email delivery is required
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
